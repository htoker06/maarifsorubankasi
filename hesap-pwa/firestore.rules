rules_version = '2';

// Yalnızca odanın (en fazla 2) üyesi okuyup yazabilir.
// Sunucu şifreli metin saklar; bu kurallar erişimi iki cihazla sınırlar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      function members() { return resource.data.members; }

      // Odayı yalnızca üyeler okuyabilir
      allow read: if request.auth != null && request.auth.uid in members();

      // İlk üye odayı oluşturur (kendini tek üye olarak ekler)
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // İkinci üye yalnızca kendini ekleyebilir (mevcut üyeyi bozmadan, en fazla 2)
      allow update: if request.auth != null
        && resource.data.members.size() == 1
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] == resource.data.members[0]
        && request.resource.data.members[1] == request.auth.uid;

      allow delete: if false;

      // Açık anahtarlar: üyeler okur; herkes yalnızca KENDİ anahtarını yazar
      match /keys/{keyUid} {
        function roomMembers() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in roomMembers();
        allow write: if request.auth != null
          && keyUid == request.auth.uid
          && request.auth.uid in roomMembers();
      }

      // Mesajlar (yalnızca şifreli): üyeler okur; gönderen kendi adına yazar;
      // değiştirme/silme kapalı
      match /messages/{msgId} {
        function roomMembers() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in roomMembers();
        allow create: if request.auth != null
          && request.auth.uid in roomMembers()
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
