# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun. .env.local GitHub'a GÖNDERİLMEZ.
# Değerler boş bırakılırsa uygulama "Demo Modu"nda (tarayıcıda örnek verilerle) çalışır.

# --- Tarayıcıya gömülen (gizli olmayan) değerler ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Yalnızca sunucu (Vercel Functions) tarafında kullanılır, ASLA VITE_ ile başlamaz ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=100
AI_EFFORT=high
